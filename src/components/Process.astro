---
const S=[['Discover','Listen, research and find the real problem.'],['Define','Turn insight into strategy and a creative brief.'],['Design','Explore, refine and prototype the identity and experience.'],['Deliver','Launch, document and hand over with care.']];
---
<section class="sec wrap"><header class="sh rv"><p class="label">Process</p><h2>Four steps, <em>no fog</em>.</h2></header>
<ol class="steps">{S.map(([t,d],i)=><li class="rv" style={`--d:${i*90}ms`}><span class="n">0{i+1}</span><h3>{t}</h3><p>{d}</p></li>)}</ol></section>
