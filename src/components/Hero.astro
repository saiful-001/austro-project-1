---
import { img } from '../data/images';
---
<section class="hero wrap">
  <div class="hero-copy">
    <p class="label rv d1"><span class="dot"></span>Studio concept · Booking Q1</p>
    <h1><span class="line"><span>We Make Brands</span></span><span class="line"><span>Impossible to <em class="kw" data-words="Ignore,Forget,Resist,Copy">Ignore.</em></span></span></h1>
    <p class="lede rv d3">FORM/FWD is a fictional independent studio for identity, web and campaigns — built to show how bold, art-directed work can feel.</p>
    <div class="cta rv d4"><a class="btn" href="#contact">Start a Project</a><a class="btn btn-ghost" href="#work">Explore Our Work</a></div>
  </div>
  <figure class="hero-img"><img src={img.hero} width="1400" height="1750" fetchpriority="high" alt="Creative team collaborating around laptops in a bright studio" style="object-position:50% 30%" onerror="this.style.display='none'" />
    <figcaption class="tag">Studio — sample photography</figcaption></figure>
</section>
